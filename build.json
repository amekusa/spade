{
  "name":       "my_app",
  "title":      "My App",
  "lang":       "en",
  "paths": {
    "src":        "src",
    "src_js":     "js/main.js",
    "src_css":    "css/style.less",
    "dst":        "app",
    "dst_js":     "js/main.js",
    "dst_css":    "css/style.css"
  },
  "imports": [
    {
      "resolve": "local",
      "src": "favicon.svg",
      "dst": "."
    },
    {
      "resolve": "local",
      "src": "css/extra.css",
      "dst": "css"
    }
  ],
  "tweaks": {
    "nojekyll": true,
    "404_fallback": true
  }
}
